<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Authors>phys1ks</Authors>
    <Company></Company>
    <Version>1.1.4.0</Version>
    <Description></Description>
    <Copyright>Copyright (c) 2026 phys1ks. All rights reserved. See LICENSE.</Copyright>
    <PackageProjectUrl></PackageProjectUrl>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <!-- Output assembly + root namespace renamed; Dalamud loads the plugin by AssemblyName.dll + AssemblyName.json. -->
    <AssemblyName>EtheirysProximityVoiceChat</AssemblyName>
    <RootNamespace>EtheirysProximityVoiceChat</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Leetspeak version stamp so Debug builds are visually distinct from
       Release in the in-game window title. Conditioned on Configuration only
       (not Platform) so it fires for `dotnet build -c Debug` regardless of
       whether Platform is x64 or AnyCPU. MainWindow trims to the first 3
       dotted parts, so this surfaces as "v1.3.3" in the title. -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <Version>1.3.3.7</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AsyncAwaitBestPractices" Version="10.0.0" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Ninject" Version="3.3.6" />
    <PackageReference Include="Ninject.Extensions.Factory" Version="3.3.3" />
    <PackageReference Include="NLog" Version="6.0.7" />
    <PackageReference Include="ReactiveProperty" Version="9.8.0" />
    <PackageReference Include="SocketIOClient" Version="3.1.2" />
    <PackageReference Include="WebRtcVadSharp" Version="1.3.2" />
    <PackageReference Include="WindowsInput" Version="6.4.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="YellowDogMan.RRNoise.NET" Version="0.1.9" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="EtheirysProximityVoiceChat.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- EmbeddedConfig.cs is gitignored and holds the maintainer's live
       signaling URL + token as compile-time constants. The .example.cs
       alongside it is the tracked template; the Compile Remove below
       keeps it out of the build so it doesn't conflict when both files
       coexist on a contributor's machine. -->
  <ItemGroup>
    <Compile Remove="EmbeddedConfig.example.cs" />
    <None Include="EmbeddedConfig.example.cs" />
  </ItemGroup>
</Project>
